# Copy to instrumentals/.env (git-ignored) and fill in. Never commit the real file.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud region: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional overrides
# MUSIC_GEMINI_MODEL=gemini-2.5-pro
# MUSIC_CLAUDE_MODEL=claude-opus-5-5

# Optional: read missing keys from another .env (path relative to this folder)
# MUSIC_ENV_FALLBACK=../.env
